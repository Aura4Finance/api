generator client {
  provider       = "prisma-client"
  output         = "../src/generated/prisma"
  moduleFormat   = "esm"
}

datasource db {
  provider = "postgresql"
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  encryptedSeedPhrase   String
  iv        String
  authTag   String
  createdAt DateTime @default(now())
  singleton Boolean  @unique @default(true)
}

model User {
  id              String           @id @default(uuid())
  firstname       String
  lastname        String
  email           String           @unique
  password        String
  otp             OTP?
  provider        Provider
  googleId        String?
  role            Role             @default(MERCHANT)
  businessProfile BusinessProfile?
  emailVerified   Boolean          @default(false)
  disabled        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  twoFactorEnabled  Boolean        @default(false)
  twoFactorSecret String           @default("")
}

enum Provider {
  LOCAL
  GOOGLE
}

enum Role {
  MERCHANT
  ADMIN
}

model BusinessProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  apiKey         ApiKey[]        @relation("ProfileApiKeys")
  wallet         Wallet[]        @relation("ProfileWallets")
  businessName   String
  businessSector String
  country        String
  websiteLink    String?
  onboarded      Boolean         @default(false)
  webhook        Webhook?
  userCustomers  UserCustomer[]  @relation("ProfileUserCustomers")
  transactions   Transaction[]   @relation("ProfileTransactions")
  paylinks       Paylink[]       @relation("ProfilePaylinks")
  subscriptionPlans SubscriptionPlan[]
  fiatAccounts   FiatAccount[]   @relation("ProfileFiatAccounts")
  CryptoAccount  CryptoAccount[]
  isLive         Boolean         @default(false)
}

model Webhook {
  id              String            @id @default(cuid())
  url             String
  secret          String
  events          String[]
  webhookDelivery WebhookDelivery[] @relation("WebhookDeliveryRegister")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  profileId       String            @unique
  profile         BusinessProfile   @relation(fields: [profileId], references: [id])
}

model OTP {
  id        String   @id @default(nanoid())
  secret    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
}

model Wallet {
  id                String  @id @default(cuid())
  address           String
  derivationIndex   Int
  profile           BusinessProfile? @relation("ProfileWallets", fields: [profileId], references: [id])
  profileId         String? @unique
  paymentId         String? @unique
  payment           Payment? @relation("PaymentWallet", fields: [paymentId], references: [id])
  createdAt         DateTime @default(now())
}

model WalletCounter {
  id              Int @id @default(1)
  currentIndex    Int
}


model ApiKey {
  id         String          @id @default(cuid())
  liveKey    String
  testKey    String
  createdAt  DateTime        @default(now())
  lastUsedAt DateTime?
  profile    BusinessProfile @relation("ProfileApiKeys", fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
}

model Customer {
  id            String         @id @default(cuid())
  firstname     String
  lastname      String
  email         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  mode          Mode[]
  userCustomers UserCustomer[]
  transactions  Transaction[]  @relation("CustomerTransactions")
  subscriptions Subscription[]
}

model SubscriptionPlan {
  id          String               @id @default(cuid())
  profileId   String
  profile     BusinessProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  duration    SubscriptionDuration
  amount      Float
  currency    String
  trialDays   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id         String           @id @default(cuid())
  mode       Mode
  network    Network
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime         @default(now())
  trialEndsAt DateTime?
  endsAt    DateTime?
  canceledAt DateTime?
  webhookDelivery   WebhookDelivery[] @relation("WebhookDeliverySubscriptionMap")
  webhookDeliveryId String?
  payments  Payment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())
}

enum SubscriptionDuration {
  WEEKLY
  MONTHLY
  SIX_MONTHS
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ABANDONED
  ACTIVE
  CANCELLED
  PAST_DUE
}

model UserCustomer {
  id             String          @id @default(cuid())
  profile        BusinessProfile @relation("ProfileUserCustomers", fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String
  totalSpendLive Decimal         @default(0) @db.Decimal(20, 8)
  totalSpendTest Decimal         @default(0) @db.Decimal(20, 8)
  createdAt      DateTime        @default(now())
  @@unique([profileId, customerId])
}

enum PaymentMethod {
  PAYMENT_LINK
  HOSTED_CHECKOUT
  SUBSCRIPTION
}

enum PayOutMethod {
  CRYPTO
  FIAT
}
enum Network {
  SUI
}

enum Token {
  USDC
  SUI
  IKA
  CETUS
  DEEP
  BLUE
  WAL
  LOFI
  NAVX
  ALPHA
  TRUTH
  USDT
  WBTC
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
}

model Transaction {
  id                String            @id @default(cuid())
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  currency          String
  network           Network
  amount            Float
  amountInUSDC      Float
  mode              Mode
  createdAt         DateTime          @default(now())
  confirmedAt       DateTime?
  token             Token?             @default(USDC)
  profile           BusinessProfile   @relation("ProfileTransactions", fields: [profileId], references: [id], onDelete: Cascade)
  profileId         String
  customer          Customer?         @relation("CustomerTransactions", fields: [customerId], references: [id])
  customerId        String?
  webhookDelivery   WebhookDelivery[] @relation("WebhookDeliveryTransactionMap")
  webhookDeliveryId String?
  payment           Payment?
  payout            Payout?
  refund            Refund?
}

model Paylink {
  id           String          @id @default(cuid())
  title        String
  description  String
  mode         Mode
  amount       Int
  currency     String
  images       Images[]        @relation("PaylinkImages")
  payments     Payment[]       @relation("PaylinkPayments")
  profile      BusinessProfile @relation("ProfilePaylinks", fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
}

model Images {
  id            String   @id @default(cuid())
  blobId        String
  blobObjectId  String
  paylink       Paylink  @relation("PaylinkImages", fields: [paylinkId], references: [id], onDelete: Cascade)
  paylinkId     String
}

model Payout {
  id              String         @id @default(cuid())
  method          PayOutMethod
  walletAddress   String?
  txDigest        String?
  rampOrderId     String?
  fiatAccountId   String?
  fiatAccount     FiatAccount?   @relation(fields: [fiatAccountId], references: [id])
  cryptoAccountId String?
  cryptoAccount   CryptoAccount? @relation(fields: [cryptoAccountId], references: [id])
  transactionId   String         @unique
  transaction     Transaction    @relation(fields: [transactionId], references: [id])
}

model Refund {
  id            String      @id @default(cuid())
  reason        String?
  walletAddress String
  originalTxId  String
  txDigest      String?
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

enum Mode {
  live
  test
}

model Payment {
  id              String        @id @default(cuid())
  refunded        Boolean       @default(false)
  depositAddress  String?       
  wallet          Wallet?      @relation("PaymentWallet")
  txRef           String        @unique @default(cuid())
  paymentMethod   PaymentMethod
  redirectUrl     String?      
  paylinkId       String?
  paylink         Paylink?      @relation("PaylinkPayments", fields: [paylinkId], references: [id])
  subscriptionId  String?
  billingCycleKey String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  transactionId   String        @unique
  transaction     Transaction   @relation(fields: [transactionId], references: [id])
}

model FiatAccount {
  id            String          @id @default(uuid())
  bankName      String
  bankCode      String
  accountName   String
  accountNumber String
  isPrimary     Boolean
  profileId     String
  profile       BusinessProfile @relation("ProfileFiatAccounts", fields: [profileId], references: [id], onDelete: Cascade)
  payouts       Payout[]

  @@unique([profileId, isPrimary])
}

model CryptoAccount {
  id            String           @id @default(uuid())
  walletAddress String
  network       Network
  alias         String           @unique()
  payouts       Payout[]
  profileId     String
  profile       BusinessProfile? @relation(fields: [profileId], references: [id])
}

model WebhookDelivery {
  id             String            @id @default(uuid())
  webhookId      String
  webhook        Webhook           @relation("WebhookDeliveryRegister", fields: [webhookId], references: [id])
  event          String
  transaction    Transaction?       @relation("WebhookDeliveryTransactionMap", fields: [transactionId], references: [id])
  transactionId  String?
  subscription   Subscription?      @relation("WebhookDeliverySubscriptionMap", fields: [subscriptionId], references: [id])
  subscriptionId String?
  payload        Json
  status         TransactionStatus
  attemptCount   Int
  responseStatus String?
  nextRetryAt    DateTime?
  createdAt      DateTime          @default(now())
  lastAttemptAt  DateTime          @default(now())
}

