  "item": [
    {
      "name": "Auth",
      "description": "Authentication routes for users.",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/create-account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "create-account"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\",\n  \"password\": \"Password123\",\n  \"name\": \"John Doe\"\n}"
            },
            "description": "Registers a new user account."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\",\n  \"otp\": \"123456\"\n}"
            },
            "description": "Verifies a user's email using OTP."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/resend-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\"\n}"
            },
            "description": "Resends OTP for email verification."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\",\n  \"password\": \"Password123\"\n}"
            },
            "description": "Logs in a registered user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();",
                  "",
                  "const token = responseData.data.token;",
                  "",
                  "// Save the token to an environment variable",
                  "if (token) {",
                  "    pm.environment.set('token', token);",
                  "    console.log('Token saved successfully:', token);",
                  "} else {",
                  "    console.warn('Token not found in response');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\"\n}"
            },
            "description": "Sends reset password link or OTP to user's email."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"example@email.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123\"\n}"
            },
            "description": "Resets user password using OTP."
          }
        }
      ]
    },
    {
      "name": "API Keys (Merchant)",
      "description": "Routes for merchants to manage API keys.",
      "item": [
        {
          "name": "Get All API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-keys"
              ]
            },
            "description": "Fetches all API keys for the authenticated merchant."
          }
        },
        {
          "name": "Generate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-keys"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Key\"\n}"
            },
            "description": "Creates a new API key for the merchant."
          }
        },
        {
          "name": "Get API Key Details",
          "request": {
            "method": "GET",
