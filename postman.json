                "{{keyId}}"
              ]
            },
            "description": "Fetch details of a specific API key."
          }
        },
        {
          "name": "Update API Key",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api-keys/{{keyId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-keys",
                "{{keyId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}"
            },
            "description": "Updates an existing API key."
          }
        },
        {
          "name": "Delete API Key",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api-keys/{{keyId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-keys",
                "{{keyId}}"
              ]
            },
            "description": "Deletes an API key."
          }
        }
      ]
    },
