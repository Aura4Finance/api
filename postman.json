{
  "info": {
    "name": "Orafi Postman Colection",
    "_postman_id": "a1b2c3d4-5678-9012-3456-abcdef123456",
    "description": "Professional Postman collection for Merchant and Admin API. Includes routes for authentication, API key management, and admin merchant operations.",
